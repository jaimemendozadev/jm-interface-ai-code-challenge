ANTHROPIC_API_KEY=sk-ant-your-key-here

# Target app credentials. Read only by our own code - never sent to
# Claude, which references them by symbolic key, not value (see
# tools.py's type_credential). This file is gitignored; never commit
# real values.
PARABANK_USERNAME=your-parabank-test-username
PARABANK_PASSWORD=your-parabank-test-password

# Optional overrides - both have sensible defaults if omitted.
# ANTHROPIC_MODEL=claude-sonnet-5
# MAX_STEPS=12
